PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# Logging Configuration
LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

# Node environment
NODE_ENV=production

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=khub1db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application
APP_PORT=4000

# Database connection string
DATABASE_URL=postgresql://postgres:password@localhost:5440/khub1db?schema=public&connection_limit=10&pool_timeout=20
DATABASE_URL_DOCKER=postgresql://postgres:password@db:5432/khub1db?schema=public&connection_limit=10&pool_timeout=20

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300

# RAG / Vector DB Configuration
RAG_VECTOR_DB_PROVIDER=qdrant
# Local development: http://localhost:6333
# Docker Compose (overridden automatically): http://vectordb:6333
RAG_VECTOR_DB_URL=http://localhost:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_CONVERSATION_MAX_MESSAGES=20